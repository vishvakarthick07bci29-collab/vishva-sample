bool isAnagram(char* s, char* t) {
     // If lengths are different, they cannot be anagrams
    if (strlen(s) != strlen(t)) {
        return false;
    }
    
    // Array to track character frequencies (26 lowercase English letters)
    int count[26] = {0};
    
    // Count frequencies of characters in string s
    for (int i = 0; s[i] != '\0'; i++) {
        count[s[i] - 'a']++;
    }
    
    // Decrement frequencies using string t
    for (int i = 0; t[i] != '\0'; i++) {
        count[t[i] - 'a']--;
        // If a count goes below 0, t has more of this character than s
        if (count[t[i] - 'a'] < 0) {
            return false;
        }
    }
    
    return true;
}
